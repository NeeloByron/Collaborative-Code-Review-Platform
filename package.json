{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "collaborative-code-review-platform",
  "version": "1.0.0",
  "description": "REST API for collaborative code reviews with JWT authentication and user profiles",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "predev": "npm run db:migrate",
    "prestart": "npm run db:migrate",
    "db:migrate": "node scripts/migrate.cjs",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
